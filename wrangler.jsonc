// William Gill's portfolio, served as a Cloudflare Worker with static assets.
// Deploy: `npx wrangler deploy` from this directory.
{
  "name": "wcgill-portfolio",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "wcgill.com", "custom_domain": true }
  ]
}
